{
  "name": "neural-amp-modeler-wasm",
  "version": "3.0.6",
  "description": "Neural Amp Modeler in the browser: WebAssembly engine, React player (mini / compact / full, playlists, live input) and an iframe embed bridge for partner sites",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "import": "./dist/embed/index.js"
    },
    "./embed.js": "./dist/embed.js",
    "./styles.css": "./dist/styles.css",
    "./dist/styles.css": "./dist/styles.css",
    "./dist/engine/nam-worklet.js": "./dist/engine/nam-worklet.js",
    "./dist/engine/nam-engine.wasm": "./dist/engine/nam-engine.wasm"
  },
  "typesVersions": {
    "*": {
      "engine": [
        "./dist/engine/index.d.ts"
      ],
      "embed": [
        "./dist/embed/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tone-3000/neural-amp-modeler-wasm",
    "directory": "ui"
  },
  "bugs": {
    "url": "https://github.com/tone-3000/neural-amp-modeler-wasm/issues"
  },
  "keywords": [
    "neural-amp-modeler",
    "nam",
    "tone3000",
    "guitar-amp",
    "amp-sim",
    "impulse-response",
    "webassembly",
    "audioworklet",
    "react",
    "audio",
    "dsp",
    "web-audio",
    "web-audio-api",
    "embed",
    "iframe"
  ],
  "homepage": "https://github.com/tone-3000/neural-amp-modeler-wasm#readme",
  "scripts": {
    "build": "rollup -c rollup.config.mjs && npm run copy-engine-assets",
    "copy-engine-assets": "mkdir -p dist/engine && cp src/engine/wasm/nam-engine.wasm dist/engine/",
    "dev": "rollup -c rollup.config.mjs -w",
    "clean": "rimraf dist",
    "prepare": "npm run clean && npm run build",
    "preview": "vite preview",
    "start": "npm run build && rm -rf public/engine && cp -r dist/engine public/engine && cp dist/embed.js public/embed.js && vite",
    "test:smoke": "node ../tools/smoke/nam-engine-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm run test:smoke"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-replace": "^5.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.0",
    "rollup": "^3.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwindcss": "^3.4.1",
    "tslib": "^2.5.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "author": "TONE3000 (https://www.tone3000.com)",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^0.513.0",
    "react-knob-headless": "^0.4.0"
  }
}
