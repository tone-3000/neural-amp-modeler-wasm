# This patch modifies the generated t3k-wasm-module.js:
# 1. Adds mobile device detection for iOS devices
# 2. Caps maximum WebAssembly memory: 1GB for mobile (iOS Jetsam budget),
#    2GB for desktop. Initial memory (512MB) and stack size (32MB) are baked
#    in at link time via wasm/CMakeLists.txt; the heap grows on demand up to
#    the maximum (ALLOW_MEMORY_GROWTH).
# 3. Fixes the path to t3k-wasm-module.aw.js to use absolute path
#
--- t3k-wasm-module.js
+++ t3k-wasm-module.js
@@ -1,3 +1,18 @@
+function isMobileDevice() {
+  if (
+    ENVIRONMENT_IS_NODE ||
+    ENVIRONMENT_IS_WORKER ||
+    ENVIRONMENT_IS_AUDIO_WORKLET
+  ) {
+    return false;
+  }
+  try {
+    return ENVIRONMENT_IS_WEB && /iPhone|iPad|iPod/i.test(navigator.userAgent);
+  } catch (e) {
+    return false;
+  }
+}
+
 function GROWABLE_HEAP_I8() {
   if (wasmMemory.buffer != HEAP8.buffer) {
     updateMemoryViews();
@@ -171,7 +186,7 @@
   } else {
     wasmMemory = new WebAssembly.Memory({
       initial: INITIAL_MEMORY / 65536,
-      maximum: 2147483648 / 65536,
+      maximum: isMobileDevice() ? 1073741824 / 65536 : 2147483648 / 65536, // 1GB max for mobile, 2GB for desktop
       shared: true,
     });
     if (!(wasmMemory.buffer instanceof SharedArrayBuffer)) {
@@ -187,6 +202,7 @@
     }
   }
 }
+wasmMemory.buffer;
 updateMemoryViews();
 INITIAL_MEMORY = wasmMemory.buffer.byteLength;
 var wasmTable;
@@ -3626,7 +3642,7 @@
     return audioWorkletCreationFailed();
   }
   audioWorklet
-    .addModule("t3k-wasm-module.aw.js")
+    .addModule("/t3k-wasm-module.aw.js")
     .then(() => {
       audioWorklet.bootstrapMessage = new AudioWorkletNode(
         audioContext,
